{% if ubuntu_kernel_use_binary_package %}
{# Cross-build repos are installed by the plugin through craft-archives.
   Adding a plain deb line here duplicates the suite without the matching
   Signed-By configuration and causes apt to reject the source list. #}
apt-get update

KERNEL_ABI="$(apt-cache show linux-image-{{ ubuntu_kernel_flavor }}:{{ target_arch }}/{{ ubuntu_kernel_release_name }} | perl -ne '/Version:\s+(\d+\.\d+\.\d+).(\d+).*/ && print "$1-$2\n"')"
echo "Kernel ABI: ${KERNEL_ABI}"
echo "${KERNEL_ABI}" > {{ craft_part_state_dir }}/kernel-abi

{# Module packages are named linux-modules[-<set>]-<abi>-<flavour> or
   linux-main-modules[-<set>]-<abi>-<flavour>, e.g. linux-modules-extra-*
   on jammy and noble, so match the ABI anywhere in the name. #}
IS_KERNEL_MODULE_PACKAGE='
    function is_module_package(package) {
        return (index(package, "linux-modules-") == 1 ||
                index(package, "linux-main-modules-") == 1) &&
            index(package, "-" kernel_abi "-") > 0
    }
'
mapfile -t KERNEL_PACKAGES < <(
    apt-cache depends --no-recommends \
        "linux-image-{{ ubuntu_kernel_flavor }}:{{ target_arch }}/{{ ubuntu_kernel_release_name }}" \
        | awk -v kernel_abi="${KERNEL_ABI}" "${IS_KERNEL_MODULE_PACKAGE}"'
            $1 == "Depends:" {
                package = $2
                # apt-cache wraps names in <> when nothing provides them, for
                # example a module package the archive never published.
                unavailable = package ~ /^<.*>$/
                gsub(/^<|>$/, "", package)
                if (package == "linux-firmware:{{ target_arch }}") {
                    # The arch-qualified name of an arch: all package.
                    package = "linux-firmware"
                } else if (unavailable) {
                    next
                }
                if (index(package, "linux-image-" kernel_abi "-") == 1 ||
                    is_module_package(package) ||
                    package == "linux-firmware") {
                    print package
                }
            }
        ' \
        | sort -u
)
for package in "${KERNEL_PACKAGES[@]}"; do
    if [[ "${package}" = linux-image-"${KERNEL_ABI}"-* ]]; then
        mapfile -t KERNEL_IMAGE_PACKAGES < <(
            apt-cache depends --no-recommends \
                "${package}/{{ ubuntu_kernel_release_name }}" \
                | awk -v kernel_abi="${KERNEL_ABI}" "${IS_KERNEL_MODULE_PACKAGE}"'
                    $1 == "Depends:" && $2 !~ /^<.*>$/ {
                        module = $2
                        if (is_module_package(module)) {
                            print module
                        }
                    }
                '
        )
        KERNEL_PACKAGES+=("${KERNEL_IMAGE_PACKAGES[@]}")
    fi
done

if [ -z "${KERNEL_PACKAGES[*]:-}" ]; then
    for package in \
        "linux-image-${KERNEL_ABI}-{{ ubuntu_kernel_flavor }}:{{ target_arch }}" \
        "linux-modules-${KERNEL_ABI}-{{ ubuntu_kernel_flavor }}:{{ target_arch }}" \
        "linux-modules-extra-${KERNEL_ABI}-{{ ubuntu_kernel_flavor }}:{{ target_arch }}"; do
        if apt-cache show "${package}/{{ ubuntu_kernel_release_name }}" 2>/dev/null \
            | grep -q '^Package:'; then
            KERNEL_PACKAGES+=("${package}")
        fi
    done
    if apt-cache show "linux-firmware/{{ ubuntu_kernel_release_name }}" 2>/dev/null \
        | grep -q '^Package:'; then
        KERNEL_PACKAGES+=("linux-firmware")
    fi
fi
if [ -z "${KERNEL_PACKAGES[*]:-}" ]; then
    echo "No kernel packages found for {{ ubuntu_kernel_flavor }} on {{ target_arch }}/{{ ubuntu_kernel_release_name }}"
    exit 1
fi
mapfile -t KERNEL_PACKAGES < <(printf '%s\n' "${KERNEL_PACKAGES[@]}" | sort -u)
for package in "${KERNEL_PACKAGES[@]}"; do
    apt-get download "${package}/{{ ubuntu_kernel_release_name }}"
done
main_image_file="$(find {{ craft_part_src_dir | escape_shell_word }} -type f -name "linux-image-${KERNEL_ABI}*.deb" -printf "%f" -quit)"
echo "Main image file: ${main_image_file}"
kernel_slug="${main_image_file%%_*}"
real_flavour_string="${kernel_slug#linux-image-"${KERNEL_ABI}"-*}"
if [ -z "${real_flavour_string}" ]; then
    echo "Failed to determine the ABI flavour string"
    exit 1
fi
echo "${real_flavour_string}" > {{ craft_part_state_dir }}/kernel-abi-flavour

    {% if config.extra_modules %}
apt-get install -y --no-install-recommends \
    linux-tools-"${KERNEL_ABI}"-"${real_flavour_string}":{{ target_arch }} \
    linux-headers-"${KERNEL_ABI}"-"${real_flavour_string}":{{ target_arch }}
    {% endif %}

{% endif %}
