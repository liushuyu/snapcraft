{% if ubuntu_kernel_use_binary_package %}
    {% if is_cross_compiling and target_arch != 'amd64' %}
echo \
    "deb [arch={{ target_arch }}] http://ports.ubuntu.com/ubuntu-ports \
{{ ubuntu_kernel_release_name }} main restricted universe multiverse" >> /etc/apt/sources.list.d/{{ ubuntu_kernel_release_name }}_ports.list
    {% endif %}
apt-get update

KERNEL_ABI="$(apt-cache show linux-image-{{ ubuntu_kernel_flavor }}:{{ target_arch }}/{{ ubuntu_kernel_release_name }} | perl -ne '/Version:\s+(\d+\.\d+\.\d+).(\d+).*/ && print "$1-$2\n"')"
echo "Kernel ABI: ${KERNEL_ABI}"
echo "${KERNEL_ABI}" > {{ craft_part_state_dir }}/kernel-abi

apt-get install -y -o Dir::Cache::Archives={{ craft_part_src_dir | escape_shell_word }} --download-only "linux-image-{{ ubuntu_kernel_flavor }}:{{ target_arch }}/{{ ubuntu_kernel_release_name }}"
main_image_file="$(find {{ craft_part_src_dir | escape_shell_word }} -type f -name "linux-image-${KERNEL_ABI}*.deb" -printf "%f" -quit)"
echo "Main image file: ${main_image_file}"
kernel_slug="${main_image_file%%_*}"
real_flavour_string="${kernel_slug#linux-image-"${KERNEL_ABI}"-*}"
if [ -z "${real_flavour_string}" ]; then
    echo "Failed to determine the ABI flavour string"
    exit 1
fi
echo "${real_flavour_string}" > {{ craft_part_state_dir }}/kernel-abi-flavour

    {% if config.extra_modules %}
apt-get install -y --no-install-recommends \
    linux-tools-"${KERNEL_ABI}"-"${real_flavour_string}":{{ target_arch }} \
    linux-headers-"${KERNEL_ABI}"-"${real_flavour_string}":{{ target_arch }}
    {% endif %}

{% endif %}
