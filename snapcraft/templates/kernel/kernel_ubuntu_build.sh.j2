# Ubuntu kernel snapcraft build script
# Rendered by snapcraft ubuntu-kernel plugin.
# ----
# Build on:  {{ craft_arch_build_on }}
# Build for: {{ craft_arch_build_for }}
# Snapcraft version: {{ snap_version }}
# Snap data: {{ snap_data_path }}
# Snap context: {{ snap_context }}
# ----
{% include 'kernel_macros.sh.j2' %}
env

{# Remove outputs of a previous build (for repeated builds), but keep anything
   craft-parts unpacked into the install directory before this script runs,
   such as stage-packages. #}
rm -rf {{ craft_part_install_dir }}/boot {{ craft_part_install_dir }}/modules \
    {{ craft_part_install_dir }}/lib/modules {{ craft_part_install_dir }}/dtbs \
    {{ craft_part_install_dir }}/kernel.img {{ craft_part_install_dir }}/vmlinuz-* \
    {{ craft_part_install_dir }}/System.map-* {{ craft_part_install_dir }}/config-*

mkdir -pv {{ craft_part_build_dir }}/kernel
# Get source deb packages into build arena
{% if ubuntu_kernel_use_binary_package %}
rsync -aH {{ craft_part_src_dir }}/*.deb {{ craft_part_build_dir }}/kernel
{% else %}
# --- BEGIN kernel source build ---
{#
This template is included by the build commands template when building from
source. It builds the Ubuntu kernel debian packages from source rather than
pulling prebuilt binary packages from PPA. The built packages are then used
to build the snap kernel package.
#}
rsync -aH {{ craft_part_src_dir }}/ {{ craft_part_build_dir }}/kernel-src
cd {{ craft_part_build_dir }}/kernel-src

source debian/debian.env
DEBIAN="${DEBIAN:-debian.master}"

{% if is_cross_compiling %}
    export $(dpkg-architecture -a{{ target_arch }})
{% endif %}

{% set ubuntu_kernel_tools = [] %}
{% if config.overrides and config.overrides.tools_to_build %}
    {% set ubuntu_kernel_tools = config.overrides.tools_to_build %}
{% endif %}
{% if ubuntu_kernel_tools|length > 0 %}
    echo "Updating kernel tools selection"
    sed -i 's/^\s*do_tools_\(.*\)\s*=.*/do_tools_\1 = false/g' \
        "${DEBIAN}"/rules.d/{{ target_arch }}.mk
    {% for tool in ubuntu_kernel_tools %}
        sed -i 's/^\s*do_tools_{{ tool }}\s*=.*/do_tools_{{ tool }} = true/g' \
            "${DEBIAN}"/rules.d/{{ target_arch }}.mk
    {% endfor %}
{% endif %}

{% set has_ubuntu_kernel_image_target = config.image_targets is not none %}
{% if has_ubuntu_kernel_image_target %}
    echo "Updating build target image"
    sed -i \
        's/^\s*build_image.*/build_image = {{ config.image_targets|join(' ') }}/g' \
        "${DEBIAN}"/rules.d/{{ target_arch }}.mk
    sed -i \
        's|^\s*kernel_file.*|kernel_file = arch/{{ kernel_arch }}/boot/{{ config.image_targets[0] }}|g' \
        "${DEBIAN}"/rules.d/{{ target_arch }}.mk
{% endif %}

{% set has_ubuntu_kernel_config_fragments = config.overrides.override_file or config.overrides.override_options %}
{% if has_ubuntu_kernel_config_fragments %}
    {# Create a config fragment file to update Ubuntu kernel annotations #}
    {% from 'kernel_macros.sh.j2' import merge_kernel_config with context %}
    {{ merge_kernel_config('/dev/null', craft_project_dir + '/custom_config_fragment', config.overrides.override_file, config.overrides.override_options|serialize_kernel_config) }}
    ./debian/scripts/misc/annotations \
       --arch {{ target_arch }} \
       --flavour {{ ubuntu_kernel_flavor }} \
       --update {{ craft_project_dir }}/custom_config_fragment
{% endif %}

if [[ "$UID" = '0' ]]; then
    FAKEROOT=""
else
    FAKEROOT="fakeroot"
fi
$FAKEROOT debian/rules clean
# This fails due to a change in the config, which is expected.
# Feed empty lines to stdin so kconfig selects defaults for any NEW options
# instead of blocking on an interactive prompt.
( : | $FAKEROOT debian/rules updateconfigs ) || true
$FAKEROOT debian/rules printenv

$FAKEROOT debian/rules build-{{ ubuntu_kernel_flavor }}
$FAKEROOT debian/rules binary-{{ ubuntu_kernel_flavor }}
$FAKEROOT debian/rules binary-headers

cd {{ craft_part_build_dir }}
# --- END kernel source build ---

mv -v {{ craft_part_build_dir }}/*.deb {{ craft_part_build_dir}}/kernel
{% endif %}


cd {{ craft_part_build_dir }}/kernel

{% if ubuntu_kernel_use_binary_package %}
    KERNEL_ABI="$(cat {{ craft_part_state_dir }}/kernel-abi)"
    KERNEL_ABI_FLAVOUR="$(cat {{ craft_part_state_dir }}/kernel-abi-flavour)"
    dpkg-deb -x linux-image-"${KERNEL_ABI}"-*_*.deb unpacked-linux-image
    find . -name 'linux-firmware*.deb' -maxdepth 1 -type f \
        -exec dpkg-deb -x '{}' unpacked-linux-firmware ';'
    PKGS=(linux-modules*-"${KERNEL_ABI}"-*_*.deb)
{% else %}
    KERNEL_ABI="$(dpkg-deb -f linux-modules-*-{{ ubuntu_kernel_flavor }}_*.deb Version | perl -ne '/(\d+\.\d+\.\d+).(\d+).*/ && print "$1-$2\n"')"
    KERNEL_ABI_FLAVOUR={{ ubuntu_kernel_flavor | escape_shell_word }}
    echo "${KERNEL_ABI}" > {{ craft_part_state_dir }}/kernel-abi
    echo "${KERNEL_ABI_FLAVOUR}" > {{ craft_part_state_dir }}/kernel-abi-flavour
    # Source builds are not signed yet
    find . -maxdepth 1 -type f \
        '(' -name 'linux-image-unsigned-*-{{ ubuntu_kernel_flavor }}_*.deb' -or -name 'linux-image-*-{{ ubuntu_kernel_flavor }}_*.deb' ')' \
        -exec 'dpkg-deb' '-x' '{}' unpacked-linux-image ';'
    PKGS=(linux-modules-*-{{ ubuntu_kernel_flavor }}_*.deb)
{% endif %}

for i in "${PKGS[@]}"; do
    dpkg-deb -x "$i" unpacked-linux-modules
done

# Unpack the linux deb binaries to snap package structure
{# Merge rather than mv: stage-packages may already have created usr/ etc. #}
cp -av unpacked-linux-image/. {{ craft_part_install_dir }}/
mkdir -pv {{ craft_part_install_dir }}/lib
if test -d unpacked-linux-modules/lib/modules; then
    mv -v unpacked-linux-modules/lib/modules {{ craft_part_install_dir }}/lib/
fi
if test -d unpacked-linux-modules/usr/lib/modules; then
    cp -ar unpacked-linux-modules/usr/lib/modules {{ craft_part_install_dir }}/lib/
    rm -rf unpacked-linux-modules/usr/lib/modules
fi
mv -v unpacked-linux-modules/boot/* {{ craft_part_install_dir }}/boot/

{# Perform DKMS build #}
{% from 'kernel_macros.sh.j2' import generate_dkms_wrapper with context %}
{% if ubuntu_kernel_use_binary_package %}
{% set linux_source_tree = '/usr/src/linux-headers-${KERNEL_ABI}' %}
{% else %}
{% set linux_source_tree = craft_part_src_dir %}
{% endif %}
{% for dkms_module, _ in config.extra_modules.items() %}
{% set module_path = craft_part_src_dir + '/dkms/' + dkms_module %}
{{ generate_dkms_wrapper(dkms_module, linux_source_tree, module_path, CRAFT_PART_INSTALL, target_arch) }}
ln -sv {{ module_path|escape_shell_word }} {{ module_path|escape_shell_word }}-0
( # Build the module in a subshell to avoid polluting the environment
    "module_build_{{dkms_module}}"
)
{% endfor %}

depmod -b {{ craft_part_install_dir }} "${KERNEL_ABI}"-"${KERNEL_ABI_FLAVOUR}"

# Manipulate stock kernel layout to the snapcraft package layout.
mv -v {{ craft_part_install_dir }}/boot/* {{ craft_part_install_dir }}/
ln -fv {{ craft_part_install_dir }}/vmlinuz-"${KERNEL_ABI}"-"${KERNEL_ABI_FLAVOUR}" {{ craft_part_install_dir }}/kernel.img
mv -v {{ craft_part_install_dir }}/lib/modules {{ craft_part_install_dir }}/

# Device tree
DTBS=unpacked-linux-modules/lib/firmware/"${KERNEL_ABI}"-"${KERNEL_ABI_FLAVOUR}"/device-tree
[ -d "${DTBS}" ] && mv -v "${DTBS}" {{ craft_part_install_dir }}/dtbs

# Firmware
FIRMWARE=unpacked-linux-firmware/lib/firmware/"${KERNEL_ABI}"
[ -d "${FIRMWARE}" ] && mv -v "${FIRMWARE}" {{ craft_part_install_dir }}/firmware
rm -rf {{ craft_part_install_dir }}/boot

{% from 'kernel_macros.sh.j2' import relocate_firmware with context %}
{{ relocate_firmware() }}
