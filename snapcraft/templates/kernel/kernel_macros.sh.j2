{% macro merge_kernel_config(source, target, override_file, override_value) %}
{% set target_filename = target|escape_shell_word %}
{% if source != target %}
cp -v {{ source|escape_shell_word }} {{ target_filename }}
{% endif %}
{% if override_file %}
echo '# -- From {{ override_file }} --' >> {{ target_filename }}
cat {{ override_file|escape_shell_word }} >> {{ target_filename }}
{%- endif %}
{% if override_value %}
echo '# -- Overridden value --' >> {{ target_filename }}
cat << 'EOF' >> {{ target_filename }}
{{ override_value }}
EOF
{%- endif %}
{% endmacro %}

{% macro build_external_module(linux_tree_path, module_path, module_name, dest_path, linux_tree_path_is_shell=false) %}
{% set target = "modules" %}
{% if module_name == "$template" %}
{% set target = "" %}
{% elif module_name %}
{% set target = module_name + ".ko" %}
{% endif %}
{% set kernel_tree = linux_tree_path if linux_tree_path_is_shell else linux_tree_path|escape_shell_word %}
make -C {{ kernel_tree }} M={{ module_path|escape_shell_word }} {{ target|escape_shell_word if target }}
{% if dest_path %}
{# dest_path is plugin-constructed and may contain shell to expand at build
   time (the versioned modules dir), so it is deliberately not escaped #}
{% if module_name and module_name != "$template" %}
install -Dvm755 "{{ target }}" {{ dest_path }}/updates/dkms/{{ target|escape_shell_word }}
{% else %}
find {{ module_path|escape_shell_word }} -name "*.ko" -type f -exec sh -c 'install -Dvm755 "$1" "$2/$(basename "$1")"' _ '{}' {{ dest_path }}/updates/dkms ';'
{% endif %}
{% endif %}
{% endmacro %}

{% macro generate_dkms_wrapper(module_name, linux_tree_path, module_path, dest_path, target_arch, linux_tree_path_is_shell=false, kernel_release='"${KERNEL_ABI}"') %}
{% set config_filename = module_path + "/dkms.conf" %}
{% set kernel_tree = linux_tree_path if linux_tree_path_is_shell else linux_tree_path|escape_shell_word %}
module_build_{{module_name}}() {
    local _make_args
    local _count
    if ! test -f {{ config_filename|escape_shell_word }}; then
        {{ build_external_module(linux_tree_path, module_path, "", dest_path, linux_tree_path_is_shell=linux_tree_path_is_shell) }}
        return
    fi
    local _module_dirname _module_dir_parent _module_path
    _module_path={{ module_path|escape_shell_word }}
    _module_dirname="$(basename "${_module_path}")"
    _module_dir_parent="$(dirname "${_module_path}")"
    dkms install -a {{ target_arch|escape_shell_word }} -m "${_module_dirname}/0" --no-depmod -k {{ kernel_release }} --kernelsourcedir {{ kernel_tree }} --sourcetree "${_module_dir_parent}" --installtree "${CRAFT_PART_INSTALL}"/lib/modules --dkmstree "${CRAFT_PART_BUILD}/dkms/${_module_dirname}" --verbose
}
{% endmacro %}

{#
snapd mounts firmware/ from the kernel snap root, and Ubuntu Core install mode
fails if it is missing. Firmware staged into the part (e.g. stage-packages:
[linux-firmware]) lands in lib/firmware or, on newer releases, usr/lib/firmware.
#}
{% macro relocate_firmware(link_lib_firmware=false) %}
for _fw in usr/lib/firmware lib/firmware; do
  if [ -d "${CRAFT_PART_INSTALL}/${_fw}" ] && [ ! -L "${CRAFT_PART_INSTALL}/${_fw}" ]; then
    echo "Moving ${_fw} to firmware/..."
    mkdir -p "${CRAFT_PART_INSTALL}/firmware"
    cp -alf "${CRAFT_PART_INSTALL}/${_fw}/." "${CRAFT_PART_INSTALL}/firmware/"
    rm -rf "${CRAFT_PART_INSTALL:?}/${_fw}"
{% if link_lib_firmware %}
    if [ "${_fw}" = lib/firmware ]; then
      ln -sf ../firmware "${CRAFT_PART_INSTALL}/lib/firmware"
    fi
{% endif %}
  fi
done
mkdir -p "${CRAFT_PART_INSTALL}/firmware"
{% endmacro %}
