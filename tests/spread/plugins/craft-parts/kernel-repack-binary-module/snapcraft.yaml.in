name: pc-kernel
summary: Kernel plugin binary extra-module repack test
description: Repack a prebuilt kernel module deb with the Noble kernel.

grade: stable
build-base: core24
confinement: strict
type: kernel
version: "1"

parts:
  kernel:
    plugin: kernel
    source: .
    source-type: local
    kernel-build-config:
      build-type: binary-repack
      ubuntu-kernel-flavour: generic
      ubuntu-release-name: noble
      extra-modules:
        BINARY_MODULE_PACKAGE: null
