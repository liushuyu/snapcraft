name: pc-kernel
summary: Kernel plugin Jammy cross-architecture repack
description: Cross-repack Jammy kernel debs for the selected architecture.
grade: stable
build-base: core22
confinement: strict
type: kernel
version: "1"

architectures:
  - build-on: [amd64]
    build-for: [ARCH_PLACEHOLDER]

parts:
  kernel:
    plugin: kernel
    source: .
    source-type: local
    kernel-build-config:
      build-type: binary-repack
      ubuntu-kernel-flavour: FLAVOUR_PLACEHOLDER
      ubuntu-release-name: jammy
